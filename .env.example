# FortiOS MCP Server - Environment Variables
# Copy to .env and fill in your values

# ─── Device inventory ────────────────────────────────────────────────
# One server instance serves many FortiGates. Every tool takes a `fortigate`
# parameter naming one of them; omitting it targets the default device.
#
# Recommended layout: the inventory file holds hosts and metadata, this file
# holds the tokens. devices.yaml then contains no secrets.
#
#   .env          ->  FW_HQ_01_TOKEN=...
#   devices.yaml  ->  api_token: ${FW_HQ_01_TOKEN}
#
# Path to the inventory. Use /app/devices.yaml when running in Docker (and
# uncomment the matching volume line in docker-compose.yaml).
#FORTIOS_DEVICES_FILE=./devices.yaml

# One API token per FortiGate — each device issues its own. Name these however
# you like; devices.yaml decides which device uses which.
#FW_HQ_01_TOKEN=
#FW_HQ_02_TOKEN=
#FW_BRANCH_01_TOKEN=

# Alternatively, skip the file and inline the whole inventory as JSON. Fine for
# a handful of devices, but the tokens then live in this variable.
#FORTIOS_DEVICES=[{"name":"fw-hq-01","host":"https://fw-hq-01.example.com","api_token":"...","site":"hq","default":true}]

# Device targeted when a tool call omits `fortigate`. Overrides `default: true`
# in the inventory. Needed only if several devices are configured and none is
# marked default.
#FORTIOS_DEFAULT_DEVICE=fw-hq-01

# ─── Single device (used when no inventory above is set) ─────────────
# Leave the inventory section commented out and fill these in to run against
# one FortiGate. This is the original single-device setup and still works
# unchanged; the device is registered under FORTIOS_DEVICE_NAME.

# FortiOS host (include https:// prefix)
FORTIOS_HOST=https://192.168.1.99

# API token (generate in FortiOS: System > Administrators > REST API Admin)
FORTIOS_API_TOKEN=your-api-token-here

# VDOM to target (default: root)
FORTIOS_VDOM=root

# Whether to verify the FortiOS SSL certificate (set to false for self-signed certs)
FORTIOS_VERIFY_SSL=false

# HTTP timeout in seconds
FORTIOS_TIMEOUT=30

# Name this device gets in the inventory (how tools address it)
FORTIOS_DEVICE_NAME=default

# ─── Container image ─────────────────────────────────────────────────
# Published to both Docker Hub and GHCR. Override to pin a tag, switch
# registry, or use a locally built image.
#FORTIOS_MCP_IMAGE=omerfarukgul/fortinet-mcp-server:1.1.0
#FORTIOS_MCP_IMAGE=ghcr.io/ofaruk89/fortinet-mcp-server:1.1.0

# Container name. Override to run a second copy — an edge or PR image — beside
# the live one, together with a different MCP_PORT and COMPOSE_PROJECT_NAME.
#FORTIOS_MCP_CONTAINER_NAME=fortios-mcp

# ─── MCP server (Docker / HTTP mode) ─────────────────────────────────
# Port the container listens on AND the port published on the host.
# One variable drives both — change it here and nowhere else.
MCP_PORT=8000

# Host address docker-compose publishes the port on. IP ONLY, no port — the
# port comes from MCP_PORT above (e.g. 10.211.112.12, not 10.211.112.12:8002).
# SECURITY: binding beyond 127.0.0.1 without MCP_AUTH_TOKEN exposes every tool
# (including firewall policy create/delete) to the network.
MCP_BIND_ADDRESS=127.0.0.1

# Bearer token for HTTP authentication. When set, every request must carry
# `Authorization: Bearer <token>`. Leave empty to disable (localhost only).
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Extra Host header values accepted for DNS rebinding protection. Needed when
# clients connect via an IP or reverse-proxy hostname instead of localhost —
# set it to the value in the client's connection URL, NOT the client's IP.
# Loopback is always allowed on top of this list. JSON array or comma-separated:
#   Reverse-proxy hostname:   ["mcp.example.com"]
#   Direct Docker IP+port:    ["10.211.112.12:8000"]
#   Port wildcard (any port): ["10.211.112.12:*"]
MCP_ALLOWED_HOSTS=

# stdio | streamable-http   (Docker uses streamable-http)
MCP_TRANSPORT=streamable-http
